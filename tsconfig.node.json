{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Belt and braces: a compiled `vite.config.js` sitting next to
    // `vite.config.ts` is resolved by Vite *first*, so a stale copy
    // silently overrides the real config. Anything emitted goes here.
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
